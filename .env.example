DATABASE_URL=postgres://postgres:postgres@localhost:5432/spendwise
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Server-only AES-256 key; keep private and stable for decrypting persisted MFA secrets.
TOTP_ENCRYPTION_KEY=replace_with_a_random_32_byte_base64_key
# Change the identifier when rotating the key; retain old keys in the deployment keyring to decrypt old envelopes.
TOTP_ENCRYPTION_KEY_ID=primary
RESEND_API_KEY=re_your_server_side_api_key
RESEND_FROM_EMAIL=SpendWise <no-reply@example.com>
APP_BASE_URL=https://spendwise.example.com
